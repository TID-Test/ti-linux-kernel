		// ctrl_out_2 {
		// 	label = "ctrl-out-2";                 // Label for the LED
		// 	gpios = <&pca9555Out 1 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		// 	default-state = "off";                   // Initial state
		// };

		// ctrl_out_3 {
		// 	label = "ctrl-out-3";                 // Label for the LED
		// 	gpios = <&pca9555Out 2 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		// 	default-state = "off";                   // Initial state
		// };

		// ctrl_out_4 {
		// 	label = "ctrl-out-4";                 // Label for the LED
		// 	gpios = <&pca9555Out 3 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		// 	default-state = "off";                   // Initial state
		// };

		// ctrl_out_5 {
		// 	label = "ctrl-out-5";                 // Label for the LED
		// 	gpios = <&pca9555Out 4 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		// 	default-state = "off";                   // Initial state
		// };

		// ctrl_out_6 {
		// 	label = "ctrl-out-6";                 // Label for the LED
		// 	gpios = <&pca9555Out 5 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		// 	default-state = "off";                   // Initial state
		// };

		// ctrl_out_7 {
		// 	label = "ctrl-out-7";                 // Label for the LED
		// 	gpios = <&pca9555Out 6 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		// 	default-state = "off";                   // Initial state
