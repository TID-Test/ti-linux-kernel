		// in11 {
		// 	label = "IN-11";
		// 	linux,code = <12>; //#-
		// 	gpios = <&pca9555In 8 GPIO_ACTIVE_LOW>;
		// 	wakeup-source;
		// 	debounce-interval = <10>;  // Optional debounce (in ms)
