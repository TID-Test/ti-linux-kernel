	vdd_mmc1: regulator-3 {
		compatible = "regulator-fixed";
		regulator-name = "SD_power_en";
		pinctrl-names = "default";
		pinctrl-0 = <&vdd_mmc1_pins_default>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		enable-active-high;
		gpio = <&main_gpio0 30 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	vdd_sd_dv: regulator-4 {
		compatible = "regulator-gpio";
		regulator-name = "SD_voltage_sel";
		pinctrl-names = "default";
		pinctrl-0 = <&vdd_sd_dv_pins_default>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		gpios = <&main_gpio0 56 GPIO_ACTIVE_HIGH>;
		states = <1800000 0x0>,
				 <3300000 0x1>;
		status = "okay";
	};

	sound-wm8904 {
		status = "disabled";
	};
};

//eCAP 0
&ecap0 {
	compatible = "ti,am62-ecap-capture";
	interrupt-parent = <&gic500>;
	interrupts = <GIC_SPI 113 IRQ_TYPE_EDGE_RISING>;
	pinctrl-names = "default";
	pinctrl-0 = <&pwmin0_pins_default>;
	status = "okay";
};

//eCAP 2
&ecap2 {
	compatible = "ti,am62-ecap-capture";
	interrupt-parent = <&gic500>;
	interrupts = <GIC_SPI 115 IRQ_TYPE_EDGE_RISING>;
	pinctrl-names = "default";
	pinctrl-0 = <&pwmin2_pins_default>;
	status = "okay";
};

&cpsw3g {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_rgmii1_pins_default>;

	cpts@3d000 {
		/* MAP HW3_TS_PUSH to GENF1 */
		ti,pps = <2 1>;
	};
};

&cpsw_port2 {
	status = "disabled";
};

&dphy0 {
	status = "okay";
};

&dss {
	pinctrl-names = "default";
	pinctrl-0 = <&main_oldi0_pins_default>;
};

&dss_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	/* VP1: LVDS Output (OLDI TX 0) */
	port@0 {
		reg = <0>;
		oldi_out0: endpoint {
			remote-endpoint = <&lcd_in0>;
		};
	};
};

&epwm1 {
	status = "okay";
	pinctrl-names = "default";
};

&mailbox0_cluster0 {
	mbox_m4_0: mbox-m4-0 {
		ti,mbox-rx = <0 0 0>;
		ti,mbox-tx = <1 0 0>;
	};

	mbox_r5_0: mbox-r5-0 {
		ti,mbox-rx = <2 0 0>;
		ti,mbox-tx = <3 0 0>;
	};
};

&main_i2c0 {
	status = "disabled";
};

&main_i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c1_pins_default>;
	clock-frequency = <400000>;
	status = "okay";

	/* DS1337 RTC module */
	rtc: rtc@68 {
		compatible = "dallas,ds1337";
		reg = <0x68>;
		status = "okay";
	};

	capacitive_touch: gt911@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&main_gpio1>;
		interrupts = <16 IRQ_TYPE_EDGE_FALLING>;

		irq-gpios = <&main_gpio1 16 GPIO_ACTIVE_LOW>;
		reset-gpios = <&main_gpio1 17 GPIO_ACTIVE_LOW>;

		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;

		wakeup-source;
		status = "okay";
	};
};

// I2C#B sur dev kit
&main_i2c2 {
	// ti,ads7828
	adc: ads7828@48 {
		compatible = "ti,ads7828";
		reg = <0x48>;

		ti,ext_vref;      /* Optional: Use external reference if set */
		ti,vref_mv = <2500>;

		status = "okay";
	};

	wm8904: audio-codec@1a {
		status = "disabled";
	};

	/* GPIO expander */
	pca9555Out: pca9555Out@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;
		gpio-controller;
		pinctrl-names = "default";
		#gpio-cells = <2>;
		status = "okay";

		ctrl_out_1 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-1";                 // Label for the LED
			gpios = <0 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_2 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-2";                 // Label for the LED
			gpios = <1 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_3 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-3";                 // Label for the LED
			gpios = <2 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_4 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-4";                 // Label for the LED
			gpios = <3 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_5 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-5";                 // Label for the LED
			gpios = <4 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_6 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-6";                 // Label for the LED
			gpios = <5 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_7 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-7";                 // Label for the LED
			gpios = <6 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_8 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-8";                 // Label for the LED
			gpios = <7 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_9 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-9";                 // Label for the LED
			gpios = <8 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_10 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-10";                 // Label for the LED
			gpios = <9 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_11 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-11";                 // Label for the LED
			gpios = <10 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_12 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-12";                 // Label for the LED
			gpios = <11 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_13 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-13";                 // Label for the LED
			gpios = <12 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		ctrl_out_14 {
			gpio-hog;
			output-low;
			line-name = "ctrl-out-14";                 // Label for the LED
			gpios = <13 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		dir_motor_1 {
			gpio-hog;
			output-low;
			line-name = "dir-motor-1";                 // Label for the LED
			gpios = <14 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

		dir_motor_2 {
			gpio-hog;
			output-low;
			line-name = "dir-motor-2";                 // Label for the LED
			gpios = <15 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
		};

	};
	pca9555In: pca9555In@21 {
		compatible = "nxp,pca9555";
		reg = <0x21>;
		gpio-controller;
		pinctrl-names = "default";
		pinctrl-0 = <&pca9555_irq_default>;
		interrupt-parent = <&main_gpio1>;
		interrupts = <15 IRQ_TYPE_EDGE_FALLING>;
		#gpio-cells = <2>;
		wakeup-source;
		status = "okay";

		buzzer {
			gpio-hog;
			gpios = <12 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "buzzer";
		};

		onoffmotor1 {
			gpio-hog;
			gpios = <13 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "on-off-motor-1";                 // Label for the LED
		};

		onoffmotor2 {
			gpio-hog;
			output-low;
			gpios = <14 GPIO_ACTIVE_HIGH>;
			line-name = "on-off-motor-2";                 // Label for the LED
		};
	};

	mgc3030@42 {
		compatible = "slice,mgc3030";

		reg = <0x42>;

		status = "okay";

		ts-gpio = <&main_gpio1 25 0>; //GPIO_ACTIVE_HIGH is 0
		mclr-gpio = <&main_gpio1 24 0>;
	};
};

&main_pmx0 {
	pinctrl-names = "default";
	pinctrl-0 = <&touchrst_pins_default &touch_irq_pins_default &mgc3030_pins_default>;

	// TS and MCLR for MGC3030
	mgc3030_pins_default: mgc3030-default-pins {
		pinctrl-single,pins = <
		AM62X_IOPAD(0x01d8, PIN_OUTPUT, 7) /* (C15) MCAN0_TX.GPIO1_24 */ /*MGC3030 MCLR*/
		AM62X_IOPAD(0x01dc, PIN_INPUT, 7) /* (E15) MCAN0_RX.GPIO1_25 */ /*MGC3030 TS*/
		>;
	};

	//to disable SPI0 pins in dtsi
	main_spi0_pins_default: main_spi0-pins-default {
		pinctrl-single,pins = <>;
	};

	//touch reset pin
	touchrst_pins_default: touchrst-default-pins {
		pinctrl-single,pins = <AM62X_IOPAD(0x01bc, PIN_OUTPUT, 7) /* (A14) SPI0_CLK.GPIO1_17 */>;
	};

	//touch interrupt pin
	touch_irq_pins_default: touch-irq-default-pins {
		pinctrl-single,pins = <AM62X_IOPAD(0x01b8, PIN_INPUT, 7) /* (C13) SPI0_CS1.GPIO1_16 */>;
	};

	//Interrupt for Input GPIO Expander
	pca9555_irq_default: pca9555_irq_default {
		pinctrl-single,pins = <AM62X_IOPAD(0x01b4, PIN_INPUT, 7) /* (A13) SPI0_CS0.GPIO1_15 */>;
	};

	pwmin0_pins_default: pwmin0-default-pins {
		pinctrl-single,pins = <AM62X_IOPAD(0x01f0, PIN_INPUT, 8) /* (A18) EXT_REFCLK1.ECAP0_IN_APWM_OUT */>;
	};

	pwmin2_pins_default: pwmin2-default-pins {
		pinctrl-single,pins = <AM62X_IOPAD(0x01e4, PIN_INPUT, 8) /* (A16) I2C0_SDA.ECAP2_IN_APWM_OUT */>;
	};

	main_epwm1_pins_default: main-epwm1-pins-default {
		pinctrl-single,pins = <AM62X_IOPAD(0x019c, PIN_OUTPUT, 6) /* (B18) MCASP0_AXR1.EHRPWM1_A */>;
	};

	main_i2c1_pins_default: main-i2c1-pins-default {
		pinctrl-single,pins = <
		AM62X_IOPAD(0x1e8, PIN_INPUT_PULLUP, 0) /* (B17) I2C1_SCL */
		AM62X_IOPAD(0x1ec, PIN_INPUT_PULLUP, 0) /* (A17) I2C1_SDA */
		>;
	};

	main_mmc1_pins_default: main-mmc1-pins-default {
		pinctrl-single,pins = <
		AM62X_IOPAD(0x23c, PIN_INPUT, 0) /* (A21) MMC1_CMD */
		AM62X_IOPAD(0x234, PIN_INPUT, 0) /* (B22) MMC1_CLK */
		AM62X_IOPAD(0x230, PIN_INPUT, 0) /* (A22) MMC1_DAT0 */
		AM62X_IOPAD(0x22c, PIN_INPUT, 0) /* (B21) MMC1_DAT1 */
		AM62X_IOPAD(0x228, PIN_INPUT, 0) /* (C21) MMC1_DAT2 */
		AM62X_IOPAD(0x224, PIN_INPUT, 0) /* (D22) MMC1_DAT3 */
		AM62X_IOPAD(0x240, PIN_INPUT, 0) /* (D17) MMC1_SDCD */
		>;
	};

	main_oldi0_pins_default: main-oldi0-pins-default {
		pinctrl-single,pins = <
		AM62X_IOPAD(0x0260, PIN_INPUT, 0) /* (AA5) OLDI0_A0N */
		AM62X_IOPAD(0x025c, PIN_OUTPUT, 0) /* (Y6) OLDI0_A0P */
		AM62X_IOPAD(0x0268, PIN_OUTPUT, 0) /* (AD3) OLDI0_A1N */
		AM62X_IOPAD(0x0264, PIN_OUTPUT, 0) /* (AB4) OLDI0_A1P */
		AM62X_IOPAD(0x0270, PIN_OUTPUT, 0) /* (Y8) OLDI0_A2N */
		AM62X_IOPAD(0x026c, PIN_OUTPUT, 0) /* (AA8) OLDI0_A2P */
		AM62X_IOPAD(0x0278, PIN_OUTPUT, 0) /* (AB6) OLDI0_A3N */
		AM62X_IOPAD(0x0274, PIN_OUTPUT, 0) /* (AA7) OLDI0_A3P */
		AM62X_IOPAD(0x0280, PIN_OUTPUT, 0) /* (AC6) OLDI0_A4N */
		AM62X_IOPAD(0x027c, PIN_OUTPUT, 0) /* (AC5) OLDI0_A4P */
		AM62X_IOPAD(0x0288, PIN_OUTPUT, 0) /* (AE5) OLDI0_A5N */
		AM62X_IOPAD(0x0284, PIN_OUTPUT, 0) /* (AD6) OLDI0_A5P */
		AM62X_IOPAD(0x0290, PIN_OUTPUT, 0) /* (AE6) OLDI0_A6N */
		AM62X_IOPAD(0x028c, PIN_OUTPUT, 0) /* (AD7) OLDI0_A6P */
		AM62X_IOPAD(0x0298, PIN_OUTPUT, 0) /* (AD8) OLDI0_A7N */
		AM62X_IOPAD(0x0294, PIN_OUTPUT, 0) /* (AE7) OLDI0_A7P */
		AM62X_IOPAD(0x02a0, PIN_OUTPUT, 0) /* (AD4) OLDI0_CLK0N */
		AM62X_IOPAD(0x029c, PIN_OUTPUT, 0) /* (AE3) OLDI0_CLK0P */
		AM62X_IOPAD(0x02a8, PIN_OUTPUT, 0) /* (AE4) OLDI0_CLK1N */
		AM62X_IOPAD(0x02a4, PIN_OUTPUT, 0) /* (AD5) OLDI0_CLK1P */
		>;
	};

	main_uart0_pins_default: main-uart0-pins-default {
		pinctrl-single,pins = <
		AM62X_IOPAD(0x1c8, PIN_INPUT, 0) /* (D14) UART0_RXD */
		AM62X_IOPAD(0x1cc, PIN_OUTPUT, 0) /* (E14) UART0_TXD */
		>;
	};

	main_uart2_pins_default: main-uart2-pins-default {
		pinctrl-single,pins = <
		AM62X_IOPAD(0x005c, PIN_INPUT_PULLUP, 2) /* (R24) GPMC0_AD8.UART2_RXD */
		AM62X_IOPAD(0x0060, PIN_OUTPUT, 2) /* (R25) GPMC0_AD9.UART2_TXD */
		>;
	};

	main_usb0_pins_default: main-usb0-pins-default {
		pinctrl-single,pins = <AM62X_IOPAD(0x0254, PIN_OUTPUT, 0) /* (C20) USB0_DRVVBUS */>;
	};

	vdd_mmc1_pins_default: vdd-mmc1-pins-default {
		pinctrl-single,pins = <AM62X_IOPAD(0x0078, PIN_OUTPUT, 7) /* (U24) GPMC0_AD15.GPIO0_30 */>;
	};

	vdd_sd_dv_pins_default: vdd-sd-dv-pins-default {
		pinctrl-single,pins = <AM62X_IOPAD(0x00e4, PIN_OUTPUT, 7) /* (AA23) VOUT0_DATA11.GPIO0_56 */>;
	};
};

&main_spi0 {
	status = "disabled";
};

&main_spi2 {
	status = "disabled";
};

&main_uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart0_pins_default>;
};

&main_uart1 {
	/* Main UART1 is used by TIFS firmware */
	status = "reserved";
};

&main_uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart2_pins_default>;
	status = "okay";
};

//pins are used for luxomed
&main_uart6 {
	status = "disabled";
};

&mcu_gpio0 {
	status = "reserved";
};

&mcu_gpio_intr {
	status = "reserved";
};

&mcu_m4fss {
	mboxes = <&mailbox0_cluster0 &mbox_m4_0>;
	memory-region = <&mcu_m4fss_dma_memory_region>,
	                <&mcu_m4fss_memory_region>;
};

&mcu_rti0 {
	/* MCU RTI0 is used by M4F firmware */
	status = "reserved";
};

&{/reserved-memory} {
	framebuffer: framebuffer@ff700000 {
		reg = <0x00 0xff700000 0x00 0x008ca000>;
		no-map;
	};
};

&sdhci1 {
	/* SD Card */
	vmmc-supply = <&vdd_mmc1>;
	vqmmc-supply = <&vdd_sd_dv>;
	pinctrl-names = "default";
	pinctrl-0 = <&main_mmc1_pins_default>;
	disable-wp;
	status = "okay";
};

/* CSI2RX subsystem facilitates the capture of camera frames */
&ti_csi2rx0 {
	status = "disabled";
};

#define K3_TS_OFFSET(pa, val)    (0x4+(pa)*4) (0x10000 | val)

&timesync_router {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&cpsw_cpts>;

	/* Use Time Sync Router to map GENF1 input to HW3_TS_PUSH output */
	cpsw_cpts: cpsw-cpts {
		pinctrl-single,pins = </* pps [cpsw cpts genf1] in17 -> out12 [cpsw cpts hw3_push] */
		K3_TS_OFFSET(12, 17)
		>;
	};
};

&usb0 {
	dr_mode = "host";
	pinctrl-names = "default";
	pinctrl-0 = <&main_usb0_pins_default>;
	status = "okay";
};

&usb1 {
	status = "disabled";
};

&usbss0 {
	status = "okay";
};

&usbss1 {
	status = "disabled";
};

&wkup_r5fss0_core0 {
	mboxes = <&mailbox0_cluster0 &mbox_r5_0>;
	memory-region = <&wkup_r5fss0_core0_dma_memory_region>,
	                <&wkup_r5fss0_core0_memory_region>;
};

&wkup_rtc0 {
	status = "disabled";
};

&wkup_rti0 {
	/* WKUP RTI0 is used by DM firmware */
	status = "reserved";
};

&wkup_uart0 {
	/* WKUP UART0 is used by DM firmware */
	status = "reserved";
};
