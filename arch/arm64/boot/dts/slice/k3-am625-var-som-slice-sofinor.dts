		// in12 {
		// 	label = "IN-12";
		// 	linux,code = <13>; //#=
		// 	gpios = <&pca9555In 15 GPIO_ACTIVE_LOW>;
		// 	wakeup-source;
		// 	debounce-interval = <10>;  // Optional debounce (in ms)
		// };
	};

	// gpio-leds {
	// 	compatible = "gpio-leds";
	// 	status = "okay";

		// ctrl_out_1 {
		// 	label = "ctrl-out-1";                 // Label for the LED
		// 	gpios = <&pca9555Out 0 GPIO_ACTIVE_HIGH>;// GPIO0 pin 38 (active low PNP)
